// markdownlint-cli2 configuration (https://github.com/DavidAnson/markdownlint-cli2).
{
  "config": {
    "default": true,
    // Long lines are fine in prose and tables.
    "MD013": false,
    // The README starts with the header <picture> block, not a heading.
    "MD041": false,
    // HTML used on purpose: the README header and collapsible sections.
    "MD033": { "allowed_elements": ["picture", "source", "img", "br", "details", "summary"] },
    // Release entries repeat "### Added", "### Fixed" ...
    "MD024": { "siblings_only": true },
    // Table pipe spacing is a style preference; tables use the compact "|---|" form.
    "MD060": false
  },
  // CHANGELOG.md is generated by release-please, which leaves two blank lines after each
  // heading (MD012); linting it would fail every release pull request.
  "ignores": ["node_modules/**", ".venv/**", "dist/**", "CHANGELOG.md"]
}
